# Telegram
BOT_TOKEN=replace-with-token-from-botfather
# Single-bot compatibility mode: this bot is permanently bound to the business.
BOT_BUSINESS_ID=1
# Multi-bot mode (takes precedence over BOT_TOKEN/BOT_BUSINESS_ID). Keys match
# business_bots.token_key values. Keep real tokens in deployment secrets.
# BOT_TOKENS={"barbershop_main":"token-from-botfather","massage_main":"another-token"}

# Infrastructure (values below match docker-compose.yml defaults;
# override for local, non-Docker runs against localhost)
DATABASE_URL=postgres://booking:booking@localhost:5432/booking?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Runtime
APP_ENV=development
LOG_LEVEL=debug

# Business defaults (used when a new business is created)
DEFAULT_SLOT_INTERVAL=30
DEFAULT_MIN_BOOKING_NOTICE=60
DEFAULT_MAX_BOOKING_DAYS=30

# Notification worker
NOTIFICATION_POLL_INTERVAL=5s
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_LEASE=1m
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_DELAY=30s
